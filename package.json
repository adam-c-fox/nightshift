{
  "name": "nightshift",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "run": "tsx src/runner.ts",
    "run:dry": "tsx src/runner.ts --dry-run",
    "project": "tsx src/current-project.ts",
    "open-prs": "tsx src/open-prs.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.3"
  }
}
